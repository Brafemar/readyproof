FLASK_ENV=development
SECRET_KEY=cambiar-por-un-valor-largo-y-aleatorio
# Desarrollo local sin contraseña: solo con autenticación local configurada para permitirlo.
# Las pruebas usan un clúster temporal separado sin contraseña.
# DATABASE_URL=postgresql+psycopg://usuario@localhost:5432/readyproof
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_MODO_PRUEBA=true

# Solo configurar true cuando exista HTTPS; el ejemplo actual usa HTTP exclusivamente en loopback.
READYPROOF_HTTPS=false

# Remitente por defecto: readyproof.ar@gmail.com. MAIL_FROM tiene prioridad sobre SMTP_FROM. Configurar credenciales solo en .env.local no versionado.
MAIL_FROM=

# Contacto visible en los correos de emisión; configurar ambos en .env.local.
CONTACTO_TELEFONO=
CONTACTO_CORREO=

# Envío manual de PDF desde la pantalla; cola conserva el comportamiento anterior.
PLANILLAS_TRANSPORTE=cola
# Con gmail_api, habilitar explícitamente los destinatarios del piloto (separados por coma).
PLANILLAS_DESTINATARIOS_PRUEBA=

# Habilitación futura: conservar true hasta autorización final.
MODO_PILOTO=true
EMPRESA_MANTENEDORA=[Ejemplo] readyproof
CERTIFICADO_N=IFI-2024-00000
# Si se configura, redirige el destinatario del PDF en piloto.
DESTINATARIO_PRUEBA=
