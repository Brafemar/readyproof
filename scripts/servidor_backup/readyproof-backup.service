[Unit]
Description=Respaldo cifrado de readyproof a Drive
After=postgresql@16-main.service network-online.target
Requires=postgresql@16-main.service
Wants=network-online.target
OnFailure=readyproof-backup-alerta.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/readyproof
ExecStart=/var/backups/readyproof/backup_y_subida.sh
UMask=0077
Slice=readyproof.slice
MemoryMax=192M
CPUQuota=25%
TimeoutStartSec=30min
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/var/backups/readyproof /etc/readyproof
